# Supabase project settings - Project Settings > API in your Supabase
# dashboard (https://supabase.com/dashboard/project/_/settings/api).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - SECRET, server-only. Used by /api/capture (to look up
# which user an extension token belongs to) and /api/tokens (to mint/rotate
# tokens). Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
