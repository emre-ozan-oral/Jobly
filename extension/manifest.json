{
  "manifest_version": 3,
  "name": "Jobly - Job Application Capture",
  "version": "1.0.0",
  "description": "Capture the job you're looking at into your Jobly tracker with one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Jobly"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
